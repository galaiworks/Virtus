{
  "name": "@virtus/agent-team-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIエージェントチームMVP — 会議録・許可済み資料から根拠付きの週報・タスク候補・メール草案を作り、人間の承認を通じて安全に業務へ戻す",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/run-eval.ts",
    "demo": "tsx scripts/demo.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "ci": "npm run typecheck && npm run test && npm run eval"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

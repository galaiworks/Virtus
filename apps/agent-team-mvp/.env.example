# AIエージェントチームMVP 環境変数テンプレート
#
# 非機能要件「セキュリティ」より、ここに書く値はサーバー側にのみ置く。
# クライアント、チャットカード、ログへは出さない。
# 実ファイル(.env)は .gitignore 済み。コミットしないこと。

# ---------- サーバー ----------
PORT=3000
LOG_LEVEL=info
# 承認カードから開く詳細画面のベース URL(SSO で保護すること)
ADMIN_BASE_URL=https://admin.example.com

# ---------- データ ----------
# 未設定ならインメモリで起動する(開発・評価用)。
# 設定した場合は `npm run migrate` を先に実行する。
# DATABASE_URL=postgres://user:password@localhost:5432/agent_team_mvp

# ---------- LLM ----------
# scripted: 決定論アダプタ(評価セット・テスト用、外部通信なし)
# anthropic: 実提供元
LLM_PROVIDER=scripted
# LLM_PROVIDER=anthropic のときは必須
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ---------- チャット(FR-030: Slack か Teams の一方だけ) ----------
# memory: チャットなし(開発・評価用)
# slack : Slack 連携を有効にする
# teams : MVP では未実装。指定すると起動時に落ちる。
CHAT_PROVIDER=memory
# CHAT_PROVIDER=slack のときは必須
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
SLACK_APPROVAL_CHANNEL=#virtus-approvals

# ---------- 承認・資料 ----------
# 承認期限(時間)。手順書の Level 2「24 時間以内」に合わせる。
APPROVAL_TTL_HOURS=24
# これより古い更新日の資料を「古い資料」として扱う。
SOURCE_STALE_AFTER_DAYS=180

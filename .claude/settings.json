{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/auto-routing.sh\" SessionStart",
            "timeout": 10,
            "statusMessage": "Virtus auto-routing を読み込み中"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/auto-routing.sh\" UserPromptSubmit",
            "timeout": 10,
            "suppressOutput": true
          }
        ]
      }
    ]
  }
}

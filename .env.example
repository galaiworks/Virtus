# ============================================
# Virtus - 環境変数設定
# ============================================
# このファイルを .env にコピーして値を設定してください。
# .env は絶対に Git にコミットしないでください(.gitignore で除外済み)。

# ============================================
# 必須: Anthropic API キー(BYOK)
# ============================================
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# 顧客識別子
# ============================================
# 例: founding_001, customer_xxx
CUSTOMER_ID=founding_001
CUSTOMER_NAME=

# ============================================
# モデル設定(通常はデフォルトのまま)
# ============================================
MODEL_OPUS=claude-opus-4-7
MODEL_SONNET=claude-sonnet-4-6
MODEL_HAIKU=claude-haiku-4-5-20251001

# ============================================
# プラットフォーム API キー(必要なものだけ設定)
# ============================================

# X (Twitter)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Instagram(Graph API、ビジネスアカウント必須)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# YouTube Data API
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# LINE 公式 API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Gmail / SMTP
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SENDER_EMAIL=

# ============================================
# 分析 API キー
# ============================================

# Google Analytics 4
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Google Search Console
GSC_SERVICE_ACCOUNT_JSON=path/to/service-account.json
GSC_SITE_URL=https://your-site.com/

# ============================================
# MCP サーバー設定
# ============================================

# Notion(必須)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Google Drive
GOOGLE_DRIVE_CREDENTIALS=path/to/credentials.json

# Higgsfield(オプション、シネマ動画)
HIGGSFIELD_API_KEY=
HIGGSFIELD_ENABLED=false

# MakeUGC(オプション、UGC 広告)
MAKEUGC_API_KEY=
MAKEUGC_ENABLED=false

# ============================================
# 通知設定
# ============================================

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_ALERTS_CHANNEL_ID=

# LINE 通知(個人 LINE)
LINE_NOTIFY_TOKEN=

# ============================================
# Claude Code 設定
# ============================================
# 基本的に変更不要

# ログレベル
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Brain 層の保存先
BRAIN_DIR=./brain

# ログ保存先
LOGS_DIR=./logs

# ============================================
# 配信時刻設定(顧客タイムゾーン)
# ============================================
TIMEZONE=Asia/Tokyo

# 朝報配信時刻
MORNING_BRIEF_TIME=07:00

# 配信フェーズ時刻
DISTRIBUTION_TIME=15:00

# ============================================
# 品質設定
# ============================================

# Guardian 95 点ループ
QUALITY_THRESHOLD=95
MAX_RETRIES=3

# ============================================
# Founding Member フラグ
# ============================================
IS_FOUNDING_MEMBER=true

# ============================================
# その他
# ============================================
DEBUG=false
DRY_RUN=false  # true にすると実配信せずログのみ
